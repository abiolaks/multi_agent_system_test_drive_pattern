# --- Graph email (fabric_qa/adapters/graph_email.py) ---
EMAIL_TENANT_ID=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_SENDER_UPN=
EMAIL_RECIPIENT=

# --- Self-hosted LLM / vLLM (fabric_qa/adapters/llm_client.py) ---
# Defaults match the local vLLM launch in docs/kb-setup.md's sibling setup;
# override only if serving elsewhere or under a different model name.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=qwen3-32b-awq
LLM_API_KEY=not-needed

# --- Knowledge base / Azure AI Search (fabric_qa/adapters/azure_search.py) ---
# See docs/kb-setup.md for provisioning and role-assignment steps.
KB_SEARCH_ENDPOINT=
KB_SEARCH_INDEX_NAME=guidance
KB_TENANT_ID=
KB_CLIENT_ID=
KB_CLIENT_SECRET=
# Optional, defaults to BAAI/bge-small-en-v1.5 (see fabric_qa/adapters/embeddings.py)
KB_EMBEDDING_MODEL=
